# ===== SQL Server 连接信息 =====
MSSQL_HOST=192.168.1.170,1433
MSSQL_USER=backup_user
MSSQL_PASSWORD=CHANGE_ME

# ===== 单库 / 多库 =====
MSSQL_DB=pdm
# MSSQL_DBS=pdm,db2,db3

# ===== 输出目录 =====
BACKUP_DIR=/backup

# ===== 保留天数 =====
RETENTION_DAYS=30

# ===== 时区 =====
TZ=Asia/Shanghai

# ===== 压缩策略 =====
# 0 / 1 / auto
USE_COMPRESSION=auto

# ===== 健康检查 =====
HEALTH_MAX_AGE_HOURS=30

# ===== 通知 =====
NOTIFY_ENABLED=0
